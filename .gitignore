# Ignore everything by default
*

# Allow the gitignore file itself
!.gitignore

# Allow directory traversal
!*/

# Allow HTML files everywhere
!*.html
!**/*.html

# Allow theme manager JS
!theme-manager.js

# Allow the Exams/exam folder and all its contents
![Ee]xam*/
![Ee]xam*/**

# Still ignore compile/temp junk everywhere (including within Exams)
**/compiled/**
**/*.zo
**/*.dep
**/*.tmp
**/~$*
**/.DS_Store
**/Thumbs.db
