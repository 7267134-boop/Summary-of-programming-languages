                        <span>לולאת foreach רגילה</span>
                    </button>
                    <button onclick="showTab('arrays')" id="btn-arrays-alt" data-target="arrays" class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">2021א</span>
                        <span>מערכים משתנים - Arrays</span>
                    </button>
                    <button onclick="showTab('multi-letrec')" id="btn-multi-letrec-alt" data-target="multi-letrec"
                        class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">2020ב</span>
                        <span>Letrec מרובה פונקציות</span>
                    </button>
                    <button onclick="showTab('switch')" id="btn-switch-alt" data-target="switch" class="nav-btn">
