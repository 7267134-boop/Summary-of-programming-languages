                    </button>
                </div>


            </div>

            <!-- View: By Exams -->
            <div id="sidebar-exams" class="hidden">
                <div class="nav-group">
                    <div class="nav-group-title text-emerald-400">🎓 קיץ 2025ג</div>
                    <button onclick="showTab('exam-2025c-q3')" id="btn-exam-2025c-q3-alt" data-target="exam-2025c-q3"
                        class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">מועד 83</span>
                        <span>מעקב והסקת טיפוסים (שאלה 3)</span>
                    </button>
                    <button onclick="showTab('foreach-filter')" id="btn-foreach-filter-alt" data-target="foreach-filter"
                        class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">מועד 83</span>
                        <span>לולאת foreach מסננת (שאלה 1)</span>
                    </button>
                    <button onclick="showTab('events')" id="btn-events-alt" data-target="events" class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">מועד 84</span>
                        <span>מנגנון אירועים Events (שאלה 2)</span>
                    </button>
                </div>

                <div class="nav-group">
                    <div class="nav-group-title text-amber-400">🏛️ חורף 2024ב מועד א</div>
                    <button onclick="showTab('exam-2024b-q1')" id="btn-exam-2024b-q1-alt" data-target="exam-2024b-q1"
                        class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">שאלה 1</span>
                        <span>Enum, Match &amp; enum-elmt</span>
                    </button>
                    <button onclick="showTab('exam-2024b-q2')" id="btn-exam-2024b-q2-alt" data-target="exam-2024b-q2"
                        class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">שאלה 2</span>
                        <span>for/proc עם Skip/Break Guards</span>
                    </button>
                    <button onclick="showTab('exam-2024b-q3')" id="btn-exam-2024b-q3-alt" data-target="exam-2024b-q3"
                        class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">שאלה 3</span>
                        <span>מעקב הרצה עם if/let</span>
                    </button>
                </div>

                <div class="nav-group">
                    <div class="nav-group-title">📅 מבחני עבר</div>
                    <button onclick="showTab('tuples')" id="btn-tuples-alt" data-target="tuples" class="nav-btn">
                        <span class="text-xs bg-slate-700 px-2 py-1 rounded mr-2 text-slate-300">2021ב</span>
